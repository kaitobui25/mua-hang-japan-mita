mitajapanshop.duckdns.org {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }

    route {
        # Preserve production Google Search Console URL verification.
        @gscVerify path /google9f4ef18a410618a7.html
        handle @gscVerify {
            root * /var/lib/mita-google-verification
            file_server
        }

        # Administration and customer order details remain local-only.
        @private path /admin /admin/* /api/admin /api/admin/*
        respond @private 404

        # Only expressly allowed public API routes; checkout accepts POST only.
        @catalog {
            path /api/categories /api/catalog /api/catalog/products/*
            method GET HEAD
        }
        handle @catalog {
            reverse_proxy 127.0.0.1:3100
        }

        @checkout {
            path /api/checkout
            method POST
        }
        handle @checkout {
            reverse_proxy 127.0.0.1:3100
        }

        # Public assisted Amazon purchase requests. Accept only the explicit
        # POST routes; source throttling and quote verification remain in Fastify.
        @amazonPurchase {
            method POST
            path_regexp ^/api/amazon/(?:quotes(?:/[0-9a-fA-F-]{36}/refresh)?|browser-preview|purchase-requests|orders/[0-9a-fA-F-]{36}/shipping(?:/confirm)?)$
        }
        handle @amazonPurchase {
            reverse_proxy 127.0.0.1:3100
        }

        # Scoped owner relay: secret-bearing requests only. Fastify verifies
        # the bearer token; never forward /api/admin or order details publicly.
        @orderAlertRead {
            path /api/order-alert-relay
            method GET
        }
        handle @orderAlertRead {
            reverse_proxy 127.0.0.1:3100
        }

        @orderAlertAck {
            path_regexp ^/api/order-alert-relay/[1-9][0-9]*/ack$
            method POST
        }
        handle @orderAlertAck {
            reverse_proxy 127.0.0.1:3100
        }

        @otherApi path /api /api/*
        respond @otherApi 404

        reverse_proxy 127.0.0.1:3100
    }
}

# An unmatched HTTP Host over a valid HTTPS SNI otherwise receives Caddy's
# implicit empty 200 response. Explicitly reject these requests, including
# forged localhost Host headers. Named Mita and E-KAIWA sites take priority.
:443 {
    respond 421
}
