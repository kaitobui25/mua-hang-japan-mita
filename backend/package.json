{
  "name": "mita-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "tsx tests/run.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:setup": "tsx src/admin/owner.ts setup",
    "admin:reset": "tsx src/admin/owner.ts reset",
    "worker:once": "tsx src/worker.ts once",
    "worker:daily": "tsx src/worker.ts daily"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "pg-boss": "^12.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
