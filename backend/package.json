{
  "name": "mita-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "tsx tests/run.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:setup": "tsx src/admin/owner.ts setup",
    "admin:reset": "tsx src/admin/owner.ts reset",
    "worker:once": "tsx src/worker.ts once",
    "worker:translate": "tsx src/translator.ts once",
    "worker:translate:daily": "tsx src/translator.ts daily",
    "worker:translate:detail": "tsx src/detail-translator.ts once",
    "worker:translate:details:daily": "tsx src/detail-translator.ts daily",
    "worker:translate:details": "tsx src/detail-translator.ts once",
    "test:local-details": "tsc --noEmit false --outDir .test-local && node --test --experimental-test-isolation=none .test-local/tests/local-detail.test.js",
    "worker:backfill:seed": "tsx src/worker.ts backfill:seed",
    "worker:backfill:status": "tsx src/worker.ts backfill:status",
    "worker:backfill": "tsx src/worker.ts backfill",
    "worker:daily": "tsx src/worker.ts daily"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "fastify": "^5.6.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3",
    "pg-boss": "^12.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
